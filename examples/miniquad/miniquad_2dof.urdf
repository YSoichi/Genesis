        Izz = mr²/2 = 0.003×0.000036/2 = 5.40e-8
      CoM: femur 関節から -z 方向に femur_length/2 の位置
      足接触検出: femur CoM z > 0.020m で空中判定 (miniquad_env.py で使用)
    -->
  <link name="femur_rl">
    <inertial>
      <mass value="0.003"/>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <inertia ixx="6.52e-7" ixy="0" ixz="0" iyy="6.52e-7" iyz="0" izz="5.40e-8"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <cylinder length="0.05" radius="0.006"/>
      </geometry>
      <material name="femur_white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <cylinder length="0.05" radius="0.006"/>
      </geometry>
    </collision>
  </link>
  <!--
      toe リンク (足先ゴムチップ: sphere r=0.008, m=0.001 kg)
        I = 2mr²/5 = 2×0.001×0.000064/5 = 2.56e-8
    -->
  <link name="toe_rl">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="2.56e-8" ixy="0" ixz="0" iyy="2.56e-8" iyz="0" izz="2.56e-8"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="toe_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
    </collision>
  </link>
  <!-- femur → toe (固定: Genesis が femur に統合) -->
  <joint name="femur_rl_to_toe_rl_j" type="fixed">
    <parent link="femur_rl"/>
    <child link="toe_rl"/>
    <origin rpy="0 0 0" xyz="0 0 -0.05"/>
  </joint>
</robot>

