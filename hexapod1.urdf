<?xml version="1.0" ?>
<robot name="hexapod" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- base modelをどう配置するかという設定-->
    <link name="body">
        <inertial>
            <mass value="3.3"/>
            <origin xyz="0.0 0.0 0.0"/>
            <!-- base inertia param を聞く 慣性に関すること--> 
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03"/>
        </inertial>
        <!-- 見た目をどうするかという欄-->
        <visual>
            <geometry>
              <!--  <mesh filename="meshes/mini_body.obj"/> -->
              <!-- 円柱モデルの追加 ↑はモデル参照をしていたもの-->
                    <cylinder length="0.05" radius="0.22"/>
            </geometry>
            <!-- モデルの位置調整とはなにか? origin で指定しているのに調整を行うことの意味 -->
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <!-- 衝突判定のためのモデルの形の設定-->
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.22"/>
            </geometry>
            <origin rpy="0 0 0" xyz="0 0 0"/>
        </collision>
    </link>

    <!--!!!!!!!!!!!! Front Right Leg !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!-->
    <!-- jointの定義 continuous (連続回転型)→ 制御側で制限をかけるか, 物理的に360度回転可能-->
    <!--body → abduct(外転) → thigh(大腿) → shank(下腿) → toe(足先) -->
    <joint name="torso_to_abduct_fr_j" type="continuous">
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz="0.19 -0.049 0.0"/>
        <!-- 前後0.19m 左右0.049m の位置に長方形の形で配置-->
        <parent link="body"/>
        <child link="abduct_fr"/>
    </joint>
    <link name="abduct_fr">
        <inertial>
            <mass value="0.54"/>
            <origin xyz="0.0 -0.036 0."/>
            <inertia ixx="0.000312" ixy="0.000058" ixz="-0.00000045" 
                iyy="0.000832" iyz="0.00000095" izz="0.000249"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/mini_abad.obj"/>
            </geometry>
            <origin rpy="3.141592 0.0 1.5708" xyz="-0.055 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="meshes/mini_abad.obj"/>
            </geometry>
            <origin rpy="3.141592 0 1.5708" xyz="-0.055 0 0"/>
        </collision>
    </link>

    <joint name="abduct_fr_to_thigh_fr_j" type="continuous">
        <axis xyz="0 -1 0"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 -0.062 0.00"/>
        <parent link="abduct_fr"/>
        <child link="thigh_fr"/>
    </joint>
    <link name="thigh_fr">
        <inertial>
            <mass value="0.634"/>
            <origin xyz="0.0 -0.016 -0.02"/>
            <inertia ixx="0.000264" ixy="0.000245" ixz="-0.000013" 
                iyy="0.000306" iyz="0.000204" izz="0.002093"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/mini_upper_link.obj"/>
            </geometry>
            <origin rpy="0.0 -1.5708 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="meshes/mini_upper_link.obj"/>
            </geometry>
            <origin rpy="0 -1.5708 0" xyz="0 0 0"/>
        </collision>
    </link>

    <joint name="thigh_fr_to_knee_fr_j" type="continuous">
        <axis xyz="0 -1 0"/>
        <origin rpy="0.0 0 0.0" xyz="0.0 0.0 -0.209"/>
        <parent link="thigh_fr"/>
        <child link="shank_fr"/>
    </joint>
    <link name="shank_fr">
        <inertial>
            <mass value="0.064"/>
            <origin xyz="0.0 0.0 -0.209"/>
            <inertia ixx="0.000245" ixy="0" ixz="0.0" iyy="0.000248" iyz="0" izz="0.000006"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="meshes/mini_lower_link.obj"/>
            </geometry>
            <origin rpy="0.0 3.141592 0.0" xyz="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="meshes/mini_lower_link.obj"/>
            </geometry>
            <origin rpy="0 3.141592 0" xyz="0 0 0"/>
        </collision>
    </link>
   <!--  <link name="toe_fr">
    <contact>
      <friction_anchor/>
      <stiffness value="30000.0"/>
      <damping value="1000.0"/>
      <spinning_friction value="0.3"/>
      <lateral_friction value="3.0"/>
    </contact>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="darkgray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/>
    </inertial>
  </link>
  <joint name="toe_fr_joint" type="fixed">
    <parent link="shank_fr"/>
    <child link="toe_fr"/>
    <origin xyz="0 0 -0.18"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint> -->

 
