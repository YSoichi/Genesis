    <!--  <link name="toe_hr">
      <contact>
      <friction_anchor/>
      <!-- 設置点における摩擦の計算を安定させるためのアンカー設定 -->
      <!-- 値が高いほど地面が硬く, 低いほど沈み込むようになる -->
      <stiffness value="30000.0"/>
      <!-- 接地面の減衰係数　衝突時の跳ね返りを抑える役割 -->
      <damping value="1000.0"/>
      <!-- 地面に足先が接した状態で回転するときの摩擦抵抗 -->
      <spinning_friction value="0.3"/>
    　<!-- 横方向の摩擦係数、ロボットが地面をけったときに滑りにくさを決定する値 -->
      <lateral_friction value="3.0"/>
    </contact>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
